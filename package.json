{
  "name": "peptide-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "checkout:preview": "node scripts/preview-checkout.mjs",
    "preview": "npm run build && node scripts/preview-static.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "checkout:api": "node --env-file-if-exists=.env.checkout --import tsx server/start.ts",
    "orders": "node --env-file-if-exists=.env.checkout --import tsx server/admin.ts",
    "test": "node --import tsx --test server/checkout.test.ts"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^23.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
