# Copy to .env.checkout. This file configures only the separate Node API.
CHECKOUT_ENABLED=false
STOREFRONT_ORIGIN=http://localhost:3015
PORT=4010
# Enable only behind an ingress that appends/replaces X-Forwarded-For reliably.
TRUST_PROXY=false
ORDERS_DB_PATH=./data/orders.sqlite
# Supply your actual shipping price, allowed states, and support address.
SHIPPING_CENTS=
SHIPPING_STATES=
SUPPORT_EMAIL=
# Confirm with your tax adviser whether prices may include tax/no tax is due.
# This implementation does not calculate or add sales tax.
TAX_POLICY_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LIVE_PAYMENTS_APPROVED=false
VENMO_BUSINESS_HANDLE=
VENMO_BUSINESS_APPROVED=false
